<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="UserName" Content="UserName" HorizontalAlignment="Left" Margin="91,34,0,0" VerticalAlignment="Top"/>
        <Button Content="Password" HorizontalAlignment="Left" Margin="91,87,0,0" VerticalAlignment="Top" Width="59"/>
        <TextBox HorizontalAlignment="Left" Margin="171,34,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="131" x:Name="txtName" TextChanged="txtName_TextChanged"/>
        <TextBox HorizontalAlignment="Left" Margin="171,87,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="131" Height="20" x:Name="txtPassword" TextChanged="txtPassword_TextChanged"/>
        <Button Content="Login" HorizontalAlignment="Left" Margin="171,129,0,0" VerticalAlignment="Top" Width="84" Click="Button_Click" Height="25"/>

    </Grid>
</Window>
